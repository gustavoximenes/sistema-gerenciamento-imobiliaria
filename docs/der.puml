@startuml
!pragma layout smetana
skinparam shadowing false
hide circle
title Diagrama Entidade-Relacionamento — PostgreSQL do Supabase

entity cliente {
  * id : BIGINT <<PK>>
  --
  nome : VARCHAR(100)
  email : VARCHAR(254) <<UQ>>
  auth_id : UUID <<UQ, opcional>>
}
entity corretor {
  * id : BIGINT <<PK>>
  --
  nome : VARCHAR(100)
  email : VARCHAR(254) <<UQ>>
  creci : VARCHAR(30) <<UQ>>
}
entity proprietario {
  * id : BIGINT <<PK>>
  --
  nome : VARCHAR(100)
  email : VARCHAR(254) <<UQ>>
}
entity imovel {
  * id : BIGINT <<PK>>
  --
  * proprietario_id : BIGINT <<FK>>
  titulo : VARCHAR(100)
  bairro : VARCHAR(70)
  endereco : VARCHAR(180)
  preco : DECIMAL(14,2)
  criado_em : DATE
  status : VARCHAR(12)
}
entity horario {
  * id : BIGINT <<PK>>
  --
  * corretor_id : BIGINT <<FK>>
  * inicio : TIMESTAMP
}
entity visita {
  * id : BIGINT <<PK>>
  --
  * cliente_id : BIGINT <<FK>>
  * imovel_id : BIGINT <<FK>>
  horario_id : BIGINT <<FK composta, opcional>>
  * inicio : TIMESTAMPTZ <<FK composta quando horário existe>>
  preco_registrado : DECIMAL(14,2)
  status : VARCHAR(12)
}
entity equipe {
  * auth_id : UUID <<PK, FK auth.users>>
  --
  nome : VARCHAR(100)
  ativo : BOOLEAN
}
entity historico_navegacao {
  * id : BIGINT <<PK>>
  --
  * auth_id : UUID <<FK auth.users>>
  * imovel_id : BIGINT <<FK>>
  consultado_em : TIMESTAMPTZ
}
proprietario ||--o{ imovel
corretor ||--o{ horario
cliente ||--o{ visita
imovel ||--o{ visita
horario |o--o{ visita
imovel ||--o{ historico_navegacao
note right of visita
  A solicitação simbólica registra cliente, imóvel,
  data desejada, preço e status. O horário e o
  corretor são opcionais e podem ser atribuídos depois.
end note
@enduml
